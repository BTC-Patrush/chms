{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableSkillShellExecution": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(backups/**)",
      "Edit(backups/**)",
      "Read(storage/**)",
      "Edit(storage/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.dump)",
      "Read(*.sql.gz)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.gitignore)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(drizzle-kit *)",
      "Bash(* drizzle-kit *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(pg_restore *)",
      "Bash(dropdb *)",
      "Bash(docker exec *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose down*)",
      "Bash(docker volume *)",
      "Bash(docker system prune*)"
    ]
  }
}
